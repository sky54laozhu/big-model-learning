# 复制成 .env 后填入你有 key 的那一端（.env 已被 gitignore）

# —— Anthropic 协议端 ——（直连或走聚合器如 zenmux）
# 直连: ANTHROPIC_API_KEY 用 x-api-key 头；聚合器多用 ANTHROPIC_AUTH_TOKEN → Authorization: Bearer
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=claude-sonnet-4-6

# —— OpenAI 兼容端 ——（智普 GLM / OpenRouter / 任何 OpenAI 兼容网关）
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_API_KEY=
OPENAI_MODEL=glm-4.6
